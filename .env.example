# Порт, который прослушивает HTTP-сервер
# Можете указать любой свободный порт или использовать порт 7540
TODO_PORT=7540

# Относительный путь к файлу базы данных, значение можно изменить
# Путь к файлу отсчитывается от папки, из которой запускается сервер
# Если файл отсутствует, то при первом запуске сервер его создаст автоматически
TODO_DBFILE=scheduler.db